HEATOPS_ENVIRONMENT=development
HEATOPS_PROVIDER=auto
HEATOPS_MOCK_GRID_SIZE=8
HEATOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXT_PUBLIC_HEATOPS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Add locally after FortyGuard credentials arrive. Never commit the real value.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_TIMEOUT_SECONDS=45
FORTYGUARD_POLL_INTERVAL_SECONDS=1

# Optional. Without this, HeatOps generates the same grounded brief from templates.
GROQ_API_KEY=
HEATOPS_GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
